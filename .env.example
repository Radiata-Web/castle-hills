# Public (Vite)
VITE_IMAGE_CDN_BASE=https://img.chstainandrestoration.com
# VITE_IMAGE_CDN_FORCE=true
VITE_TURNSTILE_SITE_KEY=

# Worker / server (never expose to the client)
TURNSTILE_SECRET_KEY=
# Lean leads: CF send_email → Verified Destination Address (free).
# LEAD_EMAIL binding is configured in wrangler.jsonc (not an env string).
# Empty / *.invalid LEAD_TO_EMAIL = dry-run log+skip (preview default).
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=noreply@chstainandrestoration.com
