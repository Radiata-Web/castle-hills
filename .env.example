# Cloudflare R2 custom domain (Image Transformations via /cdn-cgi/image/...).
# Leave unset for local `vp dev` so images load from /public/photos (WAF blocks off-origin).
# Set on Netlify production (and preview if WAF allows those hosts):
#   VITE_IMAGE_CDN_BASE=https://img.chstainandrestoration.com
VITE_IMAGE_CDN_BASE=

# Force CDN URLs even in local dev (usually off — localhost Referer fails WAF).
VITE_IMAGE_CDN_FORCE=false
