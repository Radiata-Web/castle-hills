/**
 * Cloudflare Workers Static Assets — long-lived preview branch `cf-preview`.
 * Do NOT attach a production custom domain here; Netlify remains live on main.
 *
 * Workers Builds runs `wrangler preview` for non-production branches and
 * requires an explicit `previews` block (vars are NOT inherited from top-level).
 *
 * Redeploy: push to `cf-preview` (Ryan’s Workers Builds) or `pnpm run deploy`
 * on his authenticated account. Never `wrangler deploy --temporary`.
 *
 * @see docs/cloudflare-pages-migration-plan.md
 * @see docs/cloudflare-preview-setup.md
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "castle-hills-preview",
  "compatibility_date": "2026-11-07",
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
  },
  // Top-level = production-shaped Wrangler deploy path (unused for cutover;
  // this Worker stays preview-only until Ryan authorizes hosting move).
  "vars": {
    "LEAD_TO_EMAIL": "",
    "LEAD_FROM_EMAIL": "noreply@chstainandrestoration.com",
  },
  // Preview Builds (`wrangler preview`) — required; does not inherit `vars`.
  // Placeholders only: lead mail stays stubbed without RESEND_API_KEY.
  "previews": {
    "vars": {
      "LEAD_TO_EMAIL": "preview-leads-disabled@example.invalid",
      "LEAD_FROM_EMAIL": "noreply-preview@chstainandrestoration.com",
    },
  },
}
