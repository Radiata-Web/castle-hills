/**
 * Cloudflare Workers Static Assets — preview hosting on Worker `castle-hills`.
 * Netlify remains the public production site on main. Do not attach apex/www here.
 *
 * Preview custom domain: preview.chstainandrestoration.com (Access-gated).
 * Turnstile: reuse production public sitekey. Secret: TURNSTILE_SECRET.
 *
 * Never `wrangler deploy --temporary`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Existing account Worker (preview environment; Netlify remains production site).
  "name": "castle-hills",
  "compatibility_date": "2026-11-07",
  "main": "./src/server.ts",
  // Keep version/preview URLs available; workers.dev production route stays disabled.
  "preview_urls": true,
  // Access-gated preview host under the production zone (Turnstile widget already covers this zone's subdomains).
  "routes": [
    {
      "pattern": "preview.chstainandrestoration.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "issues": {
      "enabled": true,
    },
  },
  "vars": {
    "LEAD_TO_EMAIL": "ryandeyp@gmail.com",
    "LEAD_FROM_EMAIL": "noreply@chstainandrestoration.com",
    "VITE_TURNSTILE_SITE_KEY": "0x4AAAAAAF5ChtHZn6ut0JFm",
    // Exact hostnames only (server allowlist is not subdomain-aware).
    "TURNSTILE_HOSTNAMES": "chstainandrestoration.com,www.chstainandrestoration.com,preview.chstainandrestoration.com,localhost,127.0.0.1,castle-hills.ryandey.workers.dev,ballpark-castle-hills.ryandey.workers.dev,cf-preview-castle-hills.ryandey.workers.dev,preview-castle-hills.ryandey.workers.dev",
  },
  "send_email": [
    {
      "name": "LEAD_EMAIL",
    },
  ],
  // BALLPARK_PRICING_JSON is a Worker secret (wrangler secret put) — never commit rates.
  "ratelimits": [
    {
      "name": "ESTIMATE_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "previews": {
    "vars": {
      "LEAD_TO_EMAIL": "ryandeyp@gmail.com",
      "LEAD_FROM_EMAIL": "noreply-preview@chstainandrestoration.com",
      "VITE_TURNSTILE_SITE_KEY": "0x4AAAAAAF5ChtHZn6ut0JFm",
      "TURNSTILE_HOSTNAMES": "chstainandrestoration.com,www.chstainandrestoration.com,preview.chstainandrestoration.com,localhost,127.0.0.1,castle-hills.ryandey.workers.dev,ballpark-castle-hills.ryandey.workers.dev,cf-preview-castle-hills.ryandey.workers.dev,preview-castle-hills.ryandey.workers.dev",
    },
    "send_email": [
      {
        "name": "LEAD_EMAIL",
      },
    ],
    "ratelimits": [
      {
        "name": "ESTIMATE_LIMITER",
        "namespace_id": "1101",
        "simple": { "limit": 5, "period": 60 },
      },
    ],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "issues": {
        "enabled": true,
      },
    },
  },
}
