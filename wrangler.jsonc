/**
 * Cloudflare Workers Static Assets — long-lived preview branch `cf-preview`.
 * Do NOT attach a production custom domain here; Netlify remains live on main.
 *
 * Lead mail: `send_email` binding → Verified Destination Address (free).
 * Preview LEAD_TO_EMAIL: Ryan’s verified Gmail for testing.
 *
 * Never `wrangler deploy --temporary`.
 *
 * @see docs/cloudflare-pages-migration-plan.md
 * @see docs/cloudflare-preview-setup.md
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "castle-hills-preview",
  "compatibility_date": "2026-11-07",
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "issues": {
      "enabled": true,
    },
  },
  "vars": {
    "LEAD_TO_EMAIL": "ryandeyp@gmail.com",
    "LEAD_FROM_EMAIL": "noreply@chstainandrestoration.com",
  },
  "send_email": [
    {
      "name": "LEAD_EMAIL",
    },
  ],
  "previews": {
    "vars": {
      "LEAD_TO_EMAIL": "ryandeyp@gmail.com",
      "LEAD_FROM_EMAIL": "noreply-preview@chstainandrestoration.com",
    },
    "send_email": [
      {
        "name": "LEAD_EMAIL",
      },
    ],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "issues": {
        "enabled": true,
      },
    },
  },
}
