/**
 * Cloudflare Workers Static Assets — long-lived preview branch `cf-preview`.
 * Do NOT attach a production custom domain here; Netlify remains live on main.
 *
 * Turnstile: existing widget sitekey is public (VITE_ / vars).
 * Secret: Worker secret `TURNSTILE_SECRET` (never commit). Spin write waits on Ryan.
 *
 * Never `wrangler deploy --temporary`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "castle-hills-preview",
  "compatibility_date": "2026-11-07",
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "issues": {
      "enabled": true,
    },
  },
  "vars": {
    "LEAD_TO_EMAIL": "ryandeyp@gmail.com",
    "LEAD_FROM_EMAIL": "noreply@chstainandrestoration.com",
    "VITE_TURNSTILE_SITE_KEY": "0x4AAAAAAF5ChtHZn6ut0JFm",
    // Frontend hostnames siteverify may accept for this Worker (no secret).
    // Include workers.dev preview hosts Ryan’s Builds assign; keep production hosts for widget domain overlap.
    "TURNSTILE_HOSTNAMES": "chstainandrestoration.com,www.chstainandrestoration.com,localhost,127.0.0.1,castle-hills-preview.workers.dev",
  },
  "send_email": [
    {
      "name": "LEAD_EMAIL",
    },
  ],
  "previews": {
    "vars": {
      "LEAD_TO_EMAIL": "ryandeyp@gmail.com",
      "LEAD_FROM_EMAIL": "noreply-preview@chstainandrestoration.com",
      "VITE_TURNSTILE_SITE_KEY": "0x4AAAAAAF5ChtHZn6ut0JFm",
      "TURNSTILE_HOSTNAMES": "chstainandrestoration.com,www.chstainandrestoration.com,localhost,127.0.0.1,castle-hills-preview.workers.dev",
    },
    "send_email": [
      {
        "name": "LEAD_EMAIL",
      },
    ],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "issues": {
        "enabled": true,
      },
    },
  },
}
