/**
 * Cloudflare Workers Static Assets — long-lived preview branch `cf-preview`.
 * Do NOT attach a production custom domain here; Netlify remains live on main.
 *
 * Lead mail: `send_email` binding → Verified Destination Address (free).
 * Preview vars stay non-sending placeholders until Ryan verifies a destination.
 *
 * Never `wrangler deploy --temporary`.
 *
 * @see docs/cloudflare-pages-migration-plan.md
 * @see docs/cloudflare-preview-setup.md
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "castle-hills-preview",
  "compatibility_date": "2026-11-07",
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "LEAD_TO_EMAIL": "",
    "LEAD_FROM_EMAIL": "noreply@chstainandrestoration.com",
  },
  // Free path: send only to Verified Destination Addresses in the CF account.
  // Optionally lock with "destination_address": "<verified inbox>" after setup.
  "send_email": [
    {
      "name": "LEAD_EMAIL",
    },
  ],
  "previews": {
    "vars": {
      "LEAD_TO_EMAIL": "preview-leads-disabled@example.invalid",
      "LEAD_FROM_EMAIL": "noreply-preview@chstainandrestoration.com",
    },
    "send_email": [
      {
        "name": "LEAD_EMAIL",
      },
    ],
  },
}
